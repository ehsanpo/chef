{
  "expo": {
    "name": "Chef Game & Watch",
    "slug": "chef-game-watch",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4eedd"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.chef.gamewatch",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4eedd"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    }
  }
}
